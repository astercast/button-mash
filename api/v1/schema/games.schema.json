{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Button Mash game record",
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "genre",
    "players",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Play URL. Must use an allowlisted, verified domain \u2014 no invented links."
    },
    "genre": {
      "type": "string",
      "minLength": 1
    },
    "players": {
      "type": "string",
      "enum": [
        "single",
        "multiplayer",
        "both"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Original description in our own words."
    }
  },
  "additionalProperties": false
}
