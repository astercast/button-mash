{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controls": {
      "description": "How the game is controlled, e.g. 'WASD + mouse'.",
      "minLength": 1,
      "type": "string"
    },
    "description": {
      "description": "Original description in our own words (CC0).",
      "minLength": 1,
      "type": "string"
    },
    "genre": {
      "enum": [
        "puzzle",
        "action",
        "roguelike",
        "idle",
        "multiplayer",
        "retro",
        "horror",
        "cozy"
      ],
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9-]+$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "url": {
      "description": "Play URL. Must be verified live (HTTP 200) — no invented links.",
      "format": "uri",
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "Optional tags, e.g. 'party' plus a party sub-tag (drawing/arena/shooter/board/trivia/coop/word/racing/sports/phone). Powers the party planner."
    }
  },
  "required": [
    "id",
    "title",
    "url",
    "genre",
    "controls",
    "description"
  ],
  "title": "Button Mash game record",
  "type": "object"
}
