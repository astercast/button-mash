{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Button Mash guide record",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "difficulty",
    "time_minutes",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "minLength": 1
    },
    "time_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "body"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
